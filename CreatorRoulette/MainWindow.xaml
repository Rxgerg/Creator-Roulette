<Window x:Class="CreatorRoulette.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creator Roulette"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#fdfbf2">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <TextBlock x:Name="TitleText"
                       Text="Creator Roulette"
                       FontSize="42"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="CommunityText"
                       Text="Mi comunidad"
                       FontSize="22"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <Button Content="Settings"
                    Width="200"
                    Height="45"
                    FontSize="18"
                    Click="SettingsButton_Click"/>

        </StackPanel>
    </Grid>
</Window>