<Window x:Class="CreatorRoulette.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Configuración"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Título de la app"/>
            <TextBox x:Name="AppTitleTextBox" Margin="0,5,0,15"/>

            <TextBlock Text="Nombre de la comunidad"/>
            <TextBox x:Name="CommunityNameTextBox" Margin="0,5,0,15"/>

            <TextBlock Text="Texto del botón: Girar rol"/>
            <TextBox x:Name="SpinRoleButtonTextBox" Margin="0,5,0,15"/>

            <TextBlock Text="Texto del botón: Girar personaje"/>
            <TextBox x:Name="SpinCharacterButtonTextBox" Margin="0,5,0,15"/>

            <TextBlock Text="Texto del botón: Girar reto"/>
            <TextBox x:Name="SpinChallengeButtonTextBox" Margin="0,5,0,15"/>

            <CheckBox x:Name="EnableSoundsCheckBox"
                      Content="Activar sonidos"
                      Margin="0,5,0,20"/>

            <Button Content="Guardar configuración"
                    Height="40"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </Grid>
</Window>